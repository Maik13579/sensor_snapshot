sensor_snapshot_interfaces/Region region
# Empty selects all fields unchanged. Otherwise pack these fields in this order.
# Filters still use source fields, even when those fields are omitted here.
string[] fields
# Sample every Nth column/row of the rectangle before applying filters.
uint32 downsample_factor 1
# Keep the first point per XYZ voxel after sampling/filtering; zero disables it.
# Size uses the source coordinate units (normally metres). Requires x/y/z fields.
float64 voxel_size
# Zero selects latest; otherwise closest retained header stamp, within its range.
builtin_interfaces/Time stamp
# Same reception-age semantics as GetImage.
float64 max_age_seconds
# Evaluated in request order; stop at the first failed comparison per point.
sensor_snapshot_interfaces/FieldFilter[] filters
---
sensor_snapshot_interfaces/SnapshotStatus status
uint64 sequence
float64 age_seconds
uint32 source_width
uint32 source_height
sensor_snapshot_interfaces/Region region
# Without point/voxel filters: sampled rectangle. Otherwise compact, height = 1.
# Empty on failure. An OK result may also contain zero matching points.
sensor_msgs/PointCloud2 cloud

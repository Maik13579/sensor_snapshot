sensor_snapshot_interfaces/Region region
# Sample every Nth pixel in each dimension, starting at the rectangle origin.
uint32 downsample_factor 1
# Zero selects the latest received sample. Otherwise select the closest sensor
# header stamp within the retained timestamp range (ties prefer newest receipt).
builtin_interfaces/Time stamp
# Maximum time since the C++ subscription received the cached message.
# Zero uses cache.max_age_seconds on the component (also zero = unlimited).
float64 max_age_seconds
---
sensor_snapshot_interfaces/SnapshotStatus status
# Local sequence increases on receipt. Zero means no sample was selected.
uint64 sequence
float64 age_seconds
uint32 source_width
uint32 source_height
# Actual rectangle, with zero extents resolved to source dimensions.
sensor_snapshot_interfaces/Region region
# Empty on failure. Original acquisition timestamp and frame ID are preserved.
sensor_msgs/Image image

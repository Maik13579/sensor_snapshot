<?xml version="1.0"?>
<package format="3">
  <name>sensor_snapshot_cli</name>
  <version>0.3.1</version>
  <description>ROS 2 CLI for discovering, inspecting, recording and previewing sensor snapshots.</description>
  <maintainer email="maik.knof@gmx.de">Maik Knof</maintainer>
  <license>Apache-2.0</license>
  <build_depend>python3-setuptools</build_depend>
  <exec_depend>python3-setuptools</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2cli</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_snapshot_interfaces</exec_depend>
  <exec_depend>sensor_snapshot_recorder</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-argcomplete</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
